# SpaceCRM environment configuration
# Copy this file to .env and fill in all values before running deploy.sh
# NEVER commit .env to git (it contains passwords)

# Mail server hostname — must match your DNS A record and PTR record
BILLIONMAIL_HOSTNAME=mail.spacecrm.net

# Admin panel safe path — visit https://yourdomain/<SafePath> first to unlock login
SafePath=spacecrm

# Default admin credentials (change after first login)
ADMIN_USERNAME=billion
ADMIN_PASSWORD=billion

# PostgreSQL database
DBNAME=billionmail
DBUSER=billionmail
DBPASS=CHANGE_ME_USE_STRONG_RANDOM_PASSWORD

# Redis
REDISPASS=CHANGE_ME_USE_STRONG_RANDOM_PASSWORD

# Mail ports (default values work for most servers)
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995

# Internal ports (PostgreSQL and Redis not exposed externally)
REDIS_PORT=127.0.0.1:26379
SQL_PORT=127.0.0.1:25432

# Web UI ports (nginx proxies to these)
HTTP_PORT=8888
HTTPS_PORT=8443

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Etc/UTC

# Docker internal network subnet
IPV4_NETWORK=172.66.1

# Fail2ban (y = enabled)
FAIL2BAN_INIT=y

# IP whitelist for admin panel (false = disabled, true = enabled)
IP_WHITELIST_ENABLE=false

# Log retention in days
RETENTION_DAYS=7
